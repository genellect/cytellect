{
  "context_schema": {
    "$defs": {
      "ContextChannel": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "anyOf": [
              {
                "enum": [
                  "nuclear",
                  "measure"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role"
          },
          "stain": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stain"
          },
          "token": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,31}$",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "ContextChannel",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Normalized metadata sent to the proposal service; no paths, names or values.",
    "properties": {
      "background_available": {
        "default": false,
        "title": "Background Available",
        "type": "boolean"
      },
      "channels": {
        "items": {
          "$ref": "#/$defs/ContextChannel"
        },
        "maxItems": 6,
        "minItems": 0,
        "title": "Channels",
        "type": "array"
      },
      "complete_pair_count": {
        "default": 0,
        "maximum": 10000,
        "minimum": 0,
        "title": "Complete Pair Count",
        "type": "integer"
      },
      "condition_count": {
        "default": 0,
        "maximum": 100,
        "minimum": 0,
        "title": "Condition Count",
        "type": "integer"
      },
      "field_count": {
        "maximum": 10000,
        "minimum": 0,
        "title": "Field Count",
        "type": "integer"
      },
      "goal": {
        "default": "",
        "maxLength": 2000,
        "title": "Goal",
        "type": "string"
      },
      "measured_table": {
        "default": false,
        "title": "Measured Table",
        "type": "boolean"
      },
      "pairing_known": {
        "default": false,
        "title": "Pairing Known",
        "type": "boolean"
      },
      "protocol": {
        "const": "1.1.0",
        "default": "1.1.0",
        "title": "Protocol",
        "type": "string"
      },
      "supplied_regions": {
        "default": false,
        "title": "Supplied Regions",
        "type": "boolean"
      },
      "units_known": {
        "default": false,
        "title": "Units Known",
        "type": "boolean"
      },
      "units_per_condition": {
        "items": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 100,
        "title": "Units Per Condition",
        "type": "array"
      }
    },
    "required": [
      "channels",
      "field_count"
    ],
    "title": "ProposalContext",
    "type": "object"
  },
