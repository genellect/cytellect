# Local development: copy to .env, then follow CONTRIBUTING.md.
# Purposes, ownership and storage: docs/development-environment.md.
# Never commit actual credentials. Load explicitly with uv run --env-file .env -- ...
# Paths below are relative to the checkout root; storage and Fiji MUST stay outside it.
CYTELLECT_DATA_DIR=../cytellect-data
CYTELLECT_FIJI_EXECUTABLE=../cytellect-fiji
CYTELLECT_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
CYTELLECT_SECURE_COOKIES=false
CYTELLECT_DEMO=false
NEXT_TELEMETRY_DISABLED=1
# Shared development accepts only the registered public image/table bytes.
CYTELLECT_UPLOAD_ALLOWLIST=fixtures/public/uploads.json

# Optional cloud GPU: obtain a development URL and proxy token from the owner.
# REMOTE_TOKEN is the Modal proxy ID and Secret joined with a dot, not a deploy token.
# Keep both empty to use a separately installed local CPU runtime instead.
CYTELLECT_CELLPOSE_REMOTE_URL=
CYTELLECT_CELLPOSE_REMOTE_TOKEN=
# Alternative for scripts/dev.py: CYTELLECT_MODAL_PROXY_KEY / CYTELLECT_MODAL_PROXY_SECRET.
# Direct cytellect-worker startup needs the REMOTE_URL and joined REMOTE_TOKEN above.
# Local CPU alternative: use the paths printed by scripts/dev.py setup --cellpose DIR.
# CYTELLECT_CELLPOSE_PYTHON=
# CYTELLECT_CELLPOSE_MODEL_DIR=

# Optional proposal relay: obtain this development environment's device token.
# Never put the operator's OPENAI_API_KEY or ADMIN_TOKEN in this file.
# Use either TOKEN or TOKEN_FILE, not both. TOKEN_FILE must be outside the checkout.
# Empty values leave this optional service disabled/unconfigured.
CYTELLECT_PROPOSAL_URL=
CYTELLECT_PROPOSAL_TOKEN=
CYTELLECT_PROPOSAL_TOKEN_FILE=
CYTELLECT_PROPOSAL_TIMEOUT_SECONDS=300
# Model and prompt version use the API defaults; overrides must match the Worker.

# Other API/worker limits keep their defaults; see docs/development-environment.md.
# Docker additionally needs an absolute host CYTELLECT_RUNTIME_DIR outside checkout.
# Proposal access needs infra/compose.proposal.yaml and a private TOKEN_FILE readable
# by API UID 10001. The base Docker worker has no network access for cloud GPU calls.
