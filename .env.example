# Research storage MUST be outside the repository.
CYTELLECT_DATA_DIR=/var/lib/cytellect
CYTELLECT_APP_ORIGIN=http://localhost:3000
CYTELLECT_SECURE_COOKIES=false
CYTELLECT_DEMO=false
CYTELLECT_FIJI_EXECUTABLE=
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Optional proposal relay; requires infra/compose.proposal.yaml for Docker.
# This is the installation's device token, never the operator's OpenAI API key.
# Keep the actual token in a private file outside the repository, readable by API UID 10001.
# The values below intentionally leave the optional service disabled/unconfigured.
CYTELLECT_PROPOSAL_URL=
CYTELLECT_PROPOSAL_TOKEN_FILE=
CYTELLECT_PROPOSAL_TIMEOUT_SECONDS=300
